PORT=5000
NODE_ENV=development

# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/mediscan
MONGODB_URI=

# OpenAI (server-side only - never expose to the frontend)
OPENAI_API_KEY=
# Chat model that supports structured outputs (json_schema), e.g. gpt-4o
OPENAI_MODEL=
# Speech-to-text model, e.g. whisper-1 or gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MODEL=

# Google OAuth Web client ID (same value as the frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# EXACT browser origin of the frontend (scheme + host, no trailing slash), e.g. https://mediscan.onrender.com
FRONTEND_URL=http://localhost:5173

# Bytes per PDF (default 10485760 = 10 MB)
MAX_FILE_SIZE=
# Max PDFs per assessment (default 5)
MAX_FILES=
# Session lifetime in milliseconds (default 28800000 = 8 hours)
SESSION_MAX_AGE=

# Optional
# COOKIE_SAMESITE=   # default: none in production (HTTPS), lax in development
# TRUST_PROXY=       # default: true in production or on Render
# MAX_AUDIO_SIZE=26214400
# MAX_PDF_PAGES=60
# OPENAI_TIMEOUT_MS=90000
